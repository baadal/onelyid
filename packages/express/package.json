{
  "name": "@onelyid/express",
  "version": "0.2.15",
  "description": "ATProto Auth client for Express.js",
  "author": "abraj",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "tsc": "tsc -b",
    "build": "tsup --dts",
    "build:server": "tsup",
    "prepack": "mv README.md README-bkp.md && cp ../../README.md .",
    "pack:dest": "pnpm pack --pack-destination ../../artifacts",
    "postpack": "rm -f README.md && mv README-bkp.md README.md",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules dist tsconfig.tsbuildinfo"
  },
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baadal/onelyid.git"
  },
  "keywords": [
    "onelyid",
    "atproto",
    "login",
    "auth",
    "authentication",
    "express",
    "bluesky",
    "oauth",
    "oauth2",
    "server",
    "node",
    "backend"
  ],
  "dependencies": {
    "@onelyid/common": "workspace:*",
    "cookie": "catalog:"
  },
  "peerDependencies": {
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "express": "catalog:"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true
  }
}
