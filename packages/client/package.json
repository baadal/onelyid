{
  "name": "@onelyid/client",
  "version": "0.0.0",
  "description": "ATProto Auth client",
  "author": "abraj",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "tsc": "tsc -b",
    "build": "tsup --dts",
    "build:server": "tsup",
    "pack:dest": "pnpm pack --pack-destination ../../artifacts",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules dist tsconfig.tsbuildinfo"
  },
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baadal/onelyid.git"
  },
  "keywords": [
    "onelyid",
    "atproto",
    "login",
    "auth",
    "authentication",
    "express",
    "bluesky",
    "oauth",
    "oauth2",
    "server",
    "node",
    "backend"
  ],
  "dependencies": {
    "@atproto/api": "catalog:",
    "@atproto/identity": "catalog:",
    "@atproto/lexicon": "catalog:",
    "@atproto/oauth-client": "catalog:",
    "@atproto/oauth-client-node": "catalog:",
    "@atproto/syntax": "catalog:",
    "@baadal-sdk/dapi": "catalog:",
    "@onelyid/common": "workspace:*",
    "better-sqlite3": "catalog:",
    "cookie": "catalog:",
    "iron-session": "catalog:",
    "kysely": "catalog:"
  },
  "peerDependencies": {
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "express": "catalog:"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true
  }
}
