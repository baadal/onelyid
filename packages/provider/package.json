{
  "name": "@onelyid/provider",
  "version": "0.0.0",
  "description": "ATProto OAuth provider",
  "author": "abraj",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "tsc": "tsc -b",
    "build": "tsup --dts",
    "build:server": "tsup",
    "publish": "npm publish",
    "clean": "rm -rf node_modules dist tsconfig.tsbuildinfo"
  },
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baadal/onelyid.git"
  },
  "keywords": [
    "onelyid",
    "atproto",
    "login",
    "auth",
    "authentication",
    "express",
    "bluesky",
    "oauth",
    "oauth2",
    "server",
    "node",
    "backend"
  ],
  "dependencies": {
    "@atproto/common": "^0.5.8",
    "@atproto/oauth-provider": "^0.15.4",
    "@atproto/pds": "^0.4.204"
  },
  "peerDependencies": {
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "express": "catalog:"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true
  }
}
