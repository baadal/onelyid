{
  "name": "@onelyid/common",
  "version": "0.0.0",
  "description": "Shared utils for @onelyid packages",
  "author": "abraj",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "tsc": "tsc -b",
    "build": "tsup --dts && tsc --esModuleInterop --outDir dist --rootDir src src/transports/*.ts",
    "build:server": "tsup",
    "pack:dest": "pnpm pack --pack-destination ../../artifacts",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules dist tsconfig.tsbuildinfo"
  },
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baadal/onelyid.git"
  },
  "keywords": [
    "onelyid",
    "atproto",
    "login",
    "auth",
    "authentication",
    "express",
    "bluesky",
    "oauth",
    "oauth2",
    "server",
    "node",
    "backend"
  ],
  "dependencies": {
    "@baadal-sdk/dapi": "catalog:",
    "cookie": "catalog:",
    "pino": "catalog:",
    "pino-abstract-transport": "catalog:",
    "pino-pretty": "catalog:",
    "psl": "catalog:",
    "uuid": "catalog:"
  },
  "peerDependencies": {
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "express": "catalog:"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true
  }
}
